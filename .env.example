# ============================================================
# Plantilla de variables de entorno
# Copia este archivo como .env y escribe tus datos.
# El archivo .env NO se sube al repositorio.
# ============================================================

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crud_usuarios
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_CHARSET=utf8mb4

# Certificado TLS.
# - Vacío: conexión normal, para MySQL local.
# - "true": usa el certificado incluido, necesario en TiDB Cloud.
# - Una ruta: usa tu propio archivo .pem.
DB_SSL_CA=

# --- Correo electrónico (SMTP) ---
# Para Gmail activa la verificación en 2 pasos y genera una
# "Contraseña de aplicación". Para pruebas puedes usar Mailtrap.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=email_que_envia@proveedor.com
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
SMTP_FROM_ADDRESS=email_que_envia@proveedor.com
SMTP_FROM_NAME=CRUD Usuarios
